# ОБРАЗЕЦ `.env` — здесь НЕТ секретов, только имена переменных и способ получить значения.
#
# 🔴 Правило владельца 2026-08-15, дословно: «*ключи нужно вынести в .env, никогда ключи в коде и
# других файлах не храним*». Настоящий `.env` игнорируется git (`.gitignore`, строка 11);
# файлов с ключами (`secrets/sa.json` и подобных) в проекте больше не существует.
#
# Скопируйте этот файл в `.env` и подставьте значения.

# ─────────────────────────────────────────────────────────────────────────────
# Ключи сервисных аккаунтов — base64 от JSON-ключа, ОДНОЙ строкой.
#
# Почему base64, а не сам JSON: значение проходит через `.env`, `docker --env-file` и разные
# оболочки, а фигурные скобки, запятые и кавычки каждый парсер разбирает по-своему. Base64 —
# чистый ASCII без единого спецсимвола, который нельзя разобрать неправильно.
#
# Как получить значение (ключ создаётся в Google Cloud, файл сразу превращается в строку и
# удаляется — на диске он не остаётся):
#
#   gcloud iam service-accounts keys create key.json \
#     --iam-account firebase-adminsdk-XXXX@ПРОЕКТ.iam.gserviceaccount.com --project ПРОЕКТ
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
#   rm key.json
#
# ⚠️ Контур назван в ИМЕНИ переменной, и приборы это проверяют: ключ, чей `project_id` не совпал
# с контуром, отвергается с ошибкой (`tools/lib/credentials.mjs`). Цена путаницы несимметрична —
# боевым ключом можно перезаписать данные живых людей.
NDIM_PROD_SA_B64=
NDIM_STAGE_SA_B64=

# ─────────────────────────────────────────────────────────────────────────────
# Чтение поисковых консолей по API (миссия `ideas/37`, разведка `researches/40`).
#
# Аккаунт: ndim-console-reader@ndim-space.iam.gserviceaccount.com
#
# 🔴 У этого аккаунта НЕТ и не должно быть прав в проекте. Доступ к данным Search Console
# выдаётся не через IAM, а добавлением его адреса пользователем ресурса — руками владельца
# в самой консоли (`homeworks/12`). Ролей в облаке ему не нужно ни одной.
#
# ⛔ Не подставлять сюда боевой ключ Firebase: им можно перезаписать данные живых людей, а
# прибору нужно только чтение метрик. Прибор проверяет это по `client_email` и отвергает чужой.
#
# Проверка доступа: node tools/probe-search-console.mjs
NDIM_CONSOLE_SA_B64=

# ─────────────────────────────────────────────────────────────────────────────
# Сервер синхронизации (Docker). Контейнеров два, у каждого свой ключ и своя база:
#   ndim-server-prod   → FIREBASE_PROJECT_ID=ndim-space · база (default)
#   ndim-server-stage  → FIREBASE_PROJECT_ID=ndim-stage · FIRESTORE_DATABASE_ID=ndim-db-stage
# Контейнер читает ключ из NDIM_SA_B64 — подставьте туда значение своего контура.
#
# NDIM_SA_B64=
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=
#
# Необязательные настройки цикла (значения по умолчанию — в `sync-server/index.mjs`):
# SYNC_INTERVAL_SECONDS=60
# SYNC_QUIET_SECONDS=120
# SYNC_NEWCOMER_MINUTES=30
# SYNC_FULL_AT_HOUR=0
