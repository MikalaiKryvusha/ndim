rules_version = '2';

// Правила Firebase Storage 2.0 — ЧЕРНОВИК (bugs/04 + bugs/14).
//
// ⚠️ В БОЙ ПОКА НЕ ВЫПУЩЕНЫ: на боевом проекте всё ещё правила 1.x (админ — списком email,
// bugs/04). Этот файл нужен ЭМУЛЯТОРУ Storage на стенде (`npm run stand`) — чтобы стенд
// умел фотографии (bugs/14), — и станет основой боевых правил, когда bugs/04 дойдёт до
// выпуска. Выпуск — отдельное решение, с тестами и осторожностью: на чтении аватаров
// держится показ лиц (не ужесточать сгоряча).
service firebase.storage {
  match /b/{bucket}/o {
    // Фото людей: users/{uid}/avatar/avatar.webp (наследие 1.x, EXP-0043).
    // Читает любой ВОШЕДШИЙ — паритет с правилами 1.x; пишет только сам человек.
    match /users/{uid}/avatar/{file} {
      allow read: if request.auth != null;

      /*
       * ПОТОЛОК РАЗМЕРА И ТИПА — решение владельца, интервью №008, В8 (2026-08-01):
       * дословно «А + webp/jpeg», то есть 5 МБ и только эти два формата.
       *
       * 🔴 Почему НЕ `image/.*`, как предлагал агент, и почему НЕ один `image/webp`:
       *   · Safari НЕ КОДИРУЕТ WebP из canvas и молча отдаёт PNG (`researches/23` §4).
       *     Разреши мы только webp — отрезали бы айфоны. Разреши `image/.*` — приняли бы
       *     тот самый молчаливый PNG в 27 раз тяжелее;
       *   · поэтому на Safari продукт сознательно пишет JPEG (В7), и правило пускает ровно
       *     два формата, которые продукт умеет производить.
       *
       * Побочный и полезный эффект: правило становится СТРАХОВКОЙ логики выбора формата.
       * Сломается определение — PNG будет отвергнут здесь, а не записан тихо. Отказ честный,
       * но текст его человеку обязан быть человеческим.
       *
       * ⚠️ Удаление — тоже `write`, и потолки на него не действуют: `request.resource` при
       * удалении пуст. Проверено тестом, иначе удаление фотографии оказалось бы запрещено
       * собственным потолком.
       */
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/(webp|jpeg)')));
    }
    /*
     * Всё остальное закрыто умолчанием Firebase: нет правила — нет доступа.
     *
     * ⚠️ ЭТО ЗАКРОЕТ ЖИВЫЕ ФАЙЛЫ 1.x. В боевом бакете лежат `admin/adminFunctions.js` и пять
     * документов `public/*.html` (about, pp, tou, um, disclaimer) — в 1.x они грузились в
     * приложение прямо из Storage и правились без пересборки. 2.0 их НЕ ЧИТАЕТ: тексты вшиты
     * в бандл (`researches/06`/`07`), проверено грепом по `src/`.
     *
     * Владелец 2026-08-01: «делай их бекап, и отвязываемся от них». Бэкап снят в
     * `.private/storage-1x-backup/` (вне git) — выкат перестал быть необратимым.
     */
  }
}
